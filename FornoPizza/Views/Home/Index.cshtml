@model FornoPizza.Models.Home.IndexViewModel

@{
    ViewData["Title"] = Shared.Page_Title;
}

@await Html.PartialAsync("_SiteHeader")

<main>
    <section class="hero">
        <div class="hero-copy">
            <p class="eyebrow">@Shared.Hero_Eyebrow</p>
            <h1>FORNO</h1>
            <p class="lead">@Shared.Hero_Lead</p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="#menu">@Shared.Hero_Choose</a>
                <a class="btn btn-ghost" href="#build">@Shared.Hero_Build</a>
            </div>
        </div>
        <div class="hero-visual" role="img" aria-label="@Shared.Hero_ImageAlt"></div>
    </section>
    <div id="root" data-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName"></div>
</main>

<footer class="footer">
    <span>@Shared.Footer_Brand</span>
    <span>@Shared.Footer_Hours</span>
</footer>

@section Scripts {
    <script type="module" src="~/menu/menu.js" asp-append-version="true"></script>
}