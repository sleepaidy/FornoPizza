@using FornoPizza.Data.Enums
@using FornoPizza.Data.Models
@model List<OrderData>
@{
    ViewData["Title"] = "FORNO — мои заказы";

    string StatusLabel(OrderStatus status) => status switch
    {
        OrderStatus.New => "Новый",
        OrderStatus.Confirmed => "Подтверждён",
        OrderStatus.Cooking => "Готовится",
        OrderStatus.OnTheWay => "В пути",
        OrderStatus.Delivered => "Доставлен",
        OrderStatus.Canceled => "Отменён",
        _ => status.ToString()
    };

    string PaymentLabel(PaymentMethod method) => method switch
    {
        PaymentMethod.Card => "Картой курьеру",
        PaymentMethod.Cash => "Наличными",
        PaymentMethod.Online => "Онлайн",
        _ => method.ToString()
    };

    string SizeLabel(Size size) => size switch
    {
        Size.Small => "Маленькая",
        Size.Medium => "Средняя",
        Size.Big => "Большая",
        _ => size.ToString()
    };

    string DoughLabel(Dough dough) => dough switch
    {
        Dough.Thin => "Тонкое",
        Dough.Classic => "Классическое",
        Dough.CheeseFilledCrust => "Сырный борт",
        _ => dough.ToString()
    };
}

@await Html.PartialAsync("_SiteHeader")

<main class="kitchen-page">
    <section class="kitchen-hero">
        <p class="eyebrow">Твои заказы</p>
        <h1>Мои заказы</h1>
        <p class="lead kitchen-lead">Все заказы этого аккаунта: новые, в пути, доставленные и отменённые.</p>
        <p class="kitchen-count">Всего: <strong>@Model.Count</strong></p>
    </section>

    @if (Model.Count == 0)
    {
        <section class="panel kitchen-empty">
            <h2>Заказов пока нет</h2>
            <p>Когда оформишь пиццу, она появится здесь.</p>
        </section>
    }
    else
    {
        <div class="kitchen-queue">
            @foreach (var order in Model)
            {
                <article class="panel kitchen-card" data-order-id="@order.Id">
                    <div class="kitchen-card__head">
                        <div>
                            <p class="kitchen-card__num">№ @order.Id</p>
                            <p class="kitchen-card__time">@order.DateOfOrder.ToLocalTime().ToString("dd.MM.yyyy, HH:mm")</p>
                        </div>
                        <span class="kitchen-status kitchen-status--@order.Status.ToString().ToLowerInvariant()">
                            @StatusLabel(order.Status)
                        </span>
                    </div>

                    <dl class="kitchen-meta">
                        <div>
                            <dt>Оплата</dt>
                            <dd>@PaymentLabel(order.PaymentMethod)</dd>
                        </div>
                        <div>
                            <dt>Сумма</dt>
                            <dd>@order.FinalPrice.ToString("0") ₽</dd>
                        </div>
                    </dl>

                    @if (order.OrderItems.Count > 0)
                    {
                        <ul class="cart-list">
                            @foreach (var item in order.OrderItems)
                            {
                                <li class="cart-item">
                                    <div>
                                        <strong>@item.PizzaNameInOrder</strong>
                                        <p class="cart-item__meta">@SizeLabel(item.Size) · @DoughLabel(item.Dough) · × @item.Quantity</p>
                                    </div>
                                    <span>@item.LinePrice.ToString("0") ₽</span>
                                </li>
                            }
                        </ul>
                    }

                    @if (!string.IsNullOrWhiteSpace(order.Comment))
                    {
                        <p class="kitchen-comment">@order.Comment</p>
                    }
                </article>
            }
        </div>
    }
</main>

<footer class="footer">
    <span>FORNO · мои заказы</span>
    <span>Ежедневно 11:00–23:00</span>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script src="~/js/order/my-orders.js" asp-append-version="true"></script>
