@model int
@{
    ViewData["Title"] = Orders.Success_Title;
}

@await Html.PartialAsync("_SiteHeader")

<main class="success-page">
    <section class="success-hero">
        <div class="success-copy">
            <p class="eyebrow success-eyebrow">@Orders.Success_Eyebrow</p>
            <p class="success-brand">FORNO</p>
            <h1 class="success-title">@Orders.Success_Heading</h1>
            <p class="lead success-lead">@Orders.Success_Lead</p>

            <p class="success-order-label">@Orders.Success_Number</p>
            <p class="success-order-id">№ @Model</p>

            <div class="hero-actions success-actions">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@Orders.Success_NewOrder</a>
                <a class="btn btn-ghost" asp-controller="Home" asp-action="Index">@Orders.Success_Home</a>
            </div>
        </div>
        <div class="success-visual" role="img" aria-label="@Orders.Success_ImageAlt"></div>
    </section>
</main>

<footer class="footer">
    <span>@Orders.Success_Footer</span>
    <span>@Shared.Footer_Hours</span>
</footer>
