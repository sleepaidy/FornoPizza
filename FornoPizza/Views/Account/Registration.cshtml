@model FornoPizza.Models.Auth.RegisterViewModel
@{
    ViewData["Title"] = "FORNO — регистрация";
}

<header class="top">
    <a class="logo" asp-controller="Home" asp-action="Index">FORNO</a>
    <a class="top-cta" asp-controller="Home" asp-action="Index">На главную</a>
</header>

<main class="auth-page">
    <section class="auth-layout">
        <div class="auth-copy">
            <p class="eyebrow">Для своих</p>
            <p class="success-brand">FORNO</p>
            <h1 class="success-title">Регистрация</h1>
            <p class="lead">Создайте аккаунт, чтобы оформлять заказы и следить за ними.</p>
        </div>

        <section class="panel auth-card">
            <form asp-controller="Account" asp-action="Registration" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="auth-error"></div>

                <label class="input">
                    <span>Логин</span>
                    <input asp-for="Login" autocomplete="username" />
                    <span asp-validation-for="Login" class="auth-field-error"></span>
                </label>

                <label class="input">
                    <span>Пароль</span>
                    <input asp-for="Password" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="auth-field-error"></span>
                </label>

                <label class="input">
                    <span>Повторите пароль</span>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
                </label>

                <button class="btn btn-primary btn-block" type="submit">Создать аккаунт</button>
                <p class="auth-switch">
                    Уже есть аккаунт?
                    <a asp-controller="Account" asp-action="Login">Войти</a>
                </p>
            </form>
        </section>
    </section>
</main>

<footer class="footer">
    <span>FORNO · пицца из настоящей печи</span>
    <span>Ежедневно 11:00–23:00</span>
</footer>
