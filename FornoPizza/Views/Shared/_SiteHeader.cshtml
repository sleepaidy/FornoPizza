<header class="top">
    <a class="logo" asp-controller="Home" asp-action="Index">FORNO</a>
    <nav class="nav">
        <a href="@Url.Action("Index", "Home")#menu">Меню</a>
        <a href="@Url.Action("Index", "Home")#build">Сборка</a>
        <a href="@Url.Action("Index", "Home")#order">Заказ</a>
        <a asp-controller="Kitchen" asp-action="Index">Кухня</a>
    </nav>
    <div class="top-auth">
        <a class="top-cta" href="@Url.Action("Index", "Home")#order">К оформлению</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span class="top-user">@User.Identity.Name</span>
            <form asp-controller="Account" asp-action="LogOut" method="post" class="top-logout">
                <button class="btn btn-ghost top-logout__btn" type="submit">Выйти</button>
            </form>
        }
        else
        {
            <a class="top-cta" asp-controller="Account" asp-action="Login">Войти</a>
        }
    </div>
</header>
